#!/usr/bin/env python3
from __future__ import annotations

import argparse
import html
import itertools
import json
import math
import random
import re
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Iterable


REPO = Path(__file__).resolve().parents[1]
PLAYTEST = REPO / "scripts" / "playtest"
START_X = 20.0
START_Y = 114.0
START_Z = 0.0
HALF_WIDTH = 1.3965 / 2.0

MOVES: dict[str, tuple[int, int]] = {
  "XP": (1, 0),
  "XN": (-1, 0),
  "ZP": (0, 1),
  "ZN": (0, -1),
  "XP_ZP": (1, 1),
  "XP_ZN": (1, -1),
  "XN_ZP": (-1, 1),
  "XN_ZN": (-1, -1),
}
ROUTELETS = ("XP:XP", "XP:XP_ZP", "XP:ZP", "XP:XN_ZP", "XP_ZP:XP", "XP_ZP:ZP", "XP_ZP:XP_ZN")

SURFACE_DEEP = -128
NO_CEILING = 127
TRACE_FALL_CLIP_BELOW = 3.0


@dataclass(frozen=True, order=True)
class Cell:
  dx: int
  dz: int


@dataclass(frozen=True)
class Profile:
  surface: int
  ceiling: int = NO_CEILING

  @staticmethod
  def parse(raw: str) -> "Profile":
    surface, _, ceiling = raw.partition("/")
    return Profile(parse_surface(surface), parse_ceiling(ceiling or "none"))

  def mask(self, floor_dy: int, clear_dy: int) -> int:
    mask = 0
    if self.surface != SURFACE_DEEP:
      for dy in range(floor_dy, clear_dy + 1):
        if floor_dy < dy <= self.surface:
          mask |= 1 << (dy - floor_dy)
    if self.ceiling != NO_CEILING and floor_dy <= self.ceiling <= clear_dy:
      mask |= 1 << (self.ceiling - floor_dy)
    return mask

  def label(self) -> str:
    s = "deep" if self.surface == SURFACE_DEEP else str(self.surface)
    c = "open" if self.ceiling == NO_CEILING else str(self.ceiling)
    return f"{s}/{c}"


def parse_surface(raw: str) -> int:
  token = raw.strip().lower()
  return SURFACE_DEEP if token in ("deep", "pit", "void", "none") else int(token, 0)


def parse_ceiling(raw: str) -> int:
  token = raw.strip().lower()
  return NO_CEILING if token in ("", "none", "open", "air", "n") else int(token, 0)


def yaw_for(dx: int, dz: int) -> float:
  return math.degrees(math.atan2(-dx, dz))


def prefix_mask(height: int, floor_dy: int, clear_dy: int) -> int:
  mask = 0
  for dy in range(floor_dy, clear_dy + 1):
    if floor_dy < dy <= height:
      mask |= 1 << (dy - floor_dy)
  return mask


def segment_intersects_cell(sx: float, sz: float, ex: float, ez: float, cell: Cell, radius: float, min_t: float = 1.0e-6) -> bool:
  t0 = 0.0
  t1 = 1.0
  vx = ex - sx
  vz = ez - sz
  planes = (
    (-vx, sx - (cell.dx - radius)),
    (vx, (cell.dx + 1 + radius) - sx),
    (-vz, sz - (cell.dz - radius)),
    (vz, (cell.dz + 1 + radius) - sz),
  )
  for p, q in planes:
    if abs(p) < 1.0e-12:
      if q < 0.0:
        return False
      continue
    r = q / p
    if p < 0.0:
      if r > t1:
        return False
      t0 = max(t0, r)
    else:
      if r < t0:
        return False
      t1 = min(t1, r)
  return t1 > min_t


def source_only(cell: Cell, radius: float) -> bool:
  return source_only_at(cell, 0.0, 0.0, radius)


def source_only_at(cell: Cell, sx: float, sz: float, radius: float) -> bool:
  return cell.dx < sx + radius and cell.dx + 1 > sx - radius and cell.dz < sz + radius and cell.dz + 1 > sz - radius


def candidate_cells(dx: int, dz: int, radius: float, perturbation_radius: float, overshoot: float) -> list[Cell]:
  return candidate_cells_segment(0.0, 0.0, float(dx), float(dz), radius, perturbation_radius, overshoot)


def candidate_cells_segment(sx: float, sz: float, tx: float, tz: float, radius: float, perturbation_radius: float, overshoot: float) -> list[Cell]:
  dx = tx - sx
  dz = tz - sz
  ux, uz = unit(dx, dz)
  ex = tx + ux * overshoot
  ez = tz + uz * overshoot
  r = radius + perturbation_radius
  min_x = math.floor(min(sx, ex) - r)
  max_x = math.floor(max(sx, ex) + r)
  min_z = math.floor(min(sz, ez) - r)
  max_z = math.floor(max(sz, ez) + r)
  out: list[Cell] = []
  for x in range(min_x, max_x + 1):
    for z in range(min_z, max_z + 1):
      cell = Cell(x, z)
      if source_only_at(cell, sx, sz, r):
        continue
      if segment_intersects_cell(sx, sz, ex, ez, cell, r):
        out.append(cell)
  return sorted(set(out))


def unit(dx: int, dz: int) -> tuple[float, float]:
  length = math.hypot(dx, dz)
  return dx / length, dz / length


def default_bounds(cells: Iterable[Cell], halo: int) -> tuple[int, int, int, int]:
  cells = list(cells)
  return (
    min([cell.dx for cell in cells] + [0]) - halo,
    max([cell.dx for cell in cells] + [0]) + halo,
    min([cell.dz for cell in cells] + [0]) - halo,
    max([cell.dz for cell in cells] + [0]) + halo,
  )


def profile_domain(raw: str) -> tuple[Profile, ...]:
  out = tuple(Profile.parse(token) for token in raw.split(",") if token.strip())
  if not out:
    raise SystemExit("empty profile domain")
  if len({profile.label() for profile in out}) != len(out):
    raise SystemExit("duplicate profile labels")
  return out


def product_or_sample(domain: tuple[Profile, ...], width: int, max_cases: int, seed: str) -> Iterable[tuple[Profile, ...]]:
  total = len(domain) ** width
  if max_cases <= 0 or max_cases >= total:
    return itertools.product(domain, repeat=width)
  rng = random.Random(seed)
  seen: set[tuple[int, ...]] = set()

  def sampled() -> Iterable[tuple[Profile, ...]]:
    while len(seen) < max_cases:
      ordinal = tuple(rng.randrange(len(domain)) for _ in range(width))
      if ordinal in seen:
        continue
      seen.add(ordinal)
      yield tuple(domain[i] for i in ordinal)

  return sampled()


def terrain_columns(cells: list[Cell], vector: tuple[Profile, ...], floor_dy: int, clear_dy: int) -> list[dict[str, int]]:
  return [{"dx": cell.dx, "dz": cell.dz, "mask": profile.mask(floor_dy, clear_dy)} for cell, profile in zip(cells, vector, strict=True)]


def support_quadrants(center_x: float, center_z: float, cells: list[Cell], vector: tuple[Profile, ...], default: Profile, feet_dy: int, half_width: float) -> int:
  profiles = dict(zip(cells, vector, strict=True))
  support = 0
  eps = 1.0e-6
  for ox in (-half_width + eps, half_width - eps):
    for oz in (-half_width + eps, half_width - eps):
      profile = profiles.get(Cell(math.floor(center_x + ox), math.floor(center_z + oz)), default)
      support += profile.surface == feet_dy
  return support


def digest(vector: tuple[Profile, ...]) -> str:
  return "-".join(profile.label().replace("/", "") for profile in vector)


def archetype_cases(args: argparse.Namespace, move: str, dx: int, dz: int, cells: list[Cell], bounds: tuple[int, int, int, int]) -> list[dict[str, Any]]:
  floor = Profile(0)
  deep = Profile(SURFACE_DEEP)
  cases: list[dict[str, Any]] = []
  for kind, side in (("flat", 0), ("left_void", -1), ("right_void", 1), ("one_wide_bridge", 2)):
    vector: list[Profile] = []
    for cell in cells:
      value = floor
      if kind in ("left_void", "right_void"):
        value = deep if lateral_side(dx, dz, cell) == side else floor
      elif kind == "one_wide_bridge":
        value = floor if near_centerline(dx, dz, cell, 0.75) else deep
      vector.append(value)
    cases.append(case(args, f"{move}_{kind}", dx, dz, cells, tuple(vector), bounds, 0))
  return cases


def lateral_side(dx: int, dz: int, cell: Cell) -> int:
  cx = cell.dx + 0.5
  cz = cell.dz + 0.5
  cross = dx * cz - dz * cx
  return -1 if cross < -1.0e-9 else 1 if cross > 1.0e-9 else 0


def near_centerline(dx: int, dz: int, cell: Cell, radius: float) -> bool:
  ux, uz = unit(dx, dz)
  cx = cell.dx + 0.5
  cz = cell.dz + 0.5
  progress = cx * ux + cz * uz
  lateral = abs(cx * -uz + cz * ux)
  return -0.75 <= progress <= math.hypot(dx, dz) + 0.75 and lateral <= radius


def case(args: argparse.Namespace, case_id: str, dx: int, dz: int, cells: list[Cell], vector: tuple[Profile, ...], bounds: tuple[int, int, int, int], end_dy: int) -> dict[str, Any]:
  min_dx, max_dx, min_dz, max_dz = bounds
  default = Profile(0)
  return {
    "id": case_id,
    "start": {"x": START_X, "y": START_Y, "z": START_Z, "yaw": yaw_for(dx, dz)},
    "end": {"x": START_X + dx, "y": START_Y + end_dy, "z": START_Z + dz},
    "minY": START_Y + min(0, end_dy) - args.fall_tolerance,
    "terrain": {
      "minDx": min_dx,
      "maxDx": max_dx,
      "minDz": min_dz,
      "maxDz": max_dz,
      "floorDy": args.floor_dy,
      "clearDy": args.clear_dy,
      "defaultMask": prefix_mask(0, args.floor_dy, args.clear_dy),
      "block": "minecraft:stone",
      "columns": terrain_columns(cells, vector, args.floor_dy, args.clear_dy),
    },
    "cornerCruise": {
      "move": [dx, dz],
      "cells": [[cell.dx, cell.dz] for cell in cells],
      "profiles": [profile.label() for profile in vector],
      "sourceSupport": support_quadrants(0.0, 0.0, cells, vector, default, 0, args.horse_half_width),
      "targetSupport": support_quadrants(float(dx), float(dz), cells, vector, default, end_dy, args.horse_half_width),
      "endDy": end_dy,
    },
  }


def scenario(args: argparse.Namespace) -> dict[str, Any]:
  cases: list[dict[str, Any]] = []
  mining: list[dict[str, Any]] = []
  domain = profile_domain(args.profiles)
  moves = args.move or ["XP", "ZP", "XP_ZP", "XP_ZN"]
  for move in moves:
    dx, dz = MOVES[move]
    cells = candidate_cells(dx, dz, args.horse_half_width, args.perturbation_radius, args.overshoot_horizon)
    bounds = default_bounds(cells, args.halo)
    mining.append({"move": move, "dx": dx, "dz": dz, "cells": [[cell.dx, cell.dz] for cell in cells], "profiles": [profile.label() for profile in domain]})
    if args.archetypes:
      cases.extend(c for c in archetype_cases(args, move, dx, dz, cells, bounds) if support_allowed(args, c))
    for ordinal, vector in enumerate(product_or_sample(domain, len(cells), args.max_cases, f"{args.seed}:{move}:{args.sample_seed}")):
      c = case(args, f"{move}_{ordinal:06d}_{digest(vector)}", dx, dz, cells, vector, bounds, args.end_dy)
      if support_allowed(args, c):
        cases.append(c)
  return {
    "id": args.id,
    "worldKey": args.world_key,
    "seed": args.seed,
    "dimension": "minecraft:overworld",
    "timeoutSeconds": args.timeout_seconds,
    "horse": {"movementSpeed": args.movement_speed, "jumpStrength": args.jump_strength, "initialSpeed": 0.0},
    "input": {"forward": True},
    "ticks": args.ticks,
    "endRadius": args.end_radius,
    "maxEndYError": args.max_end_y_error,
    "requireNoDamage": True,
    "requireMounted": True,
    "stopAtEnd": True,
    "failOnOvershoot": True,
    "overshootSlack": args.overshoot_slack,
    "emitTrials": args.emit_trials,
    "perturbations": {
      "longitudinal": args.longitudinal,
      "lateral": args.lateral,
      "yaw": args.yaw,
      "initialSpeed": args.initial_speed,
      "initialLateralSpeed": args.initial_lateral_speed,
    },
    "cornerCruiseMining": {"schema": 1, "moves": mining, "archetypes": args.archetypes},
    "cases": cases,
  }


def translated_cells(cells: Iterable[Cell], ox: int, oz: int) -> list[Cell]:
  return [Cell(cell.dx + ox, cell.dz + oz) for cell in cells]


def routelet_case(args: argparse.Namespace, case_id: str, first: str, second: str, cells: list[Cell], vector: tuple[Profile, ...], bounds: tuple[int, int, int, int]) -> dict[str, Any]:
  dx1, dz1 = MOVES[first]
  dx2, dz2 = MOVES[second]
  lead = args.lead_in_blocks
  tail = args.tail_blocks
  sx = START_X - lead * dx1
  sz = START_Z - lead * dz1
  ox = lead * dx1
  oz = lead * dz1
  min_dx, max_dx, min_dz, max_dz = bounds
  terrain_cells = translated_cells(cells, ox, oz)
  default = Profile(0)
  pivot_support = support_quadrants(0.0, 0.0, cells, vector, default, args.end_dy, args.horse_half_width)
  target_supports = [pivot_support]
  for i in range(1, tail + 2):
    target_supports.append(support_quadrants(float(dx2 * i), float(dz2 * i), cells, vector, default, args.end_dy, args.horse_half_width))
  targets = [{"x": START_X, "y": START_Y + args.end_dy, "z": START_Z}]
  for i in range(1, tail + 2):
    targets.append({"x": START_X + dx2 * i, "y": START_Y + args.end_dy, "z": START_Z + dz2 * i})
  terminal = targets[-1]
  return {
    "id": case_id,
    "start": {"x": sx, "y": START_Y, "z": sz, "yaw": yaw_for(dx1, dz1)},
    "targets": targets,
    "end": terminal,
    "minY": START_Y + min(0, args.end_dy) - args.fall_tolerance,
    "terrain": {
      "minDx": min_dx + ox,
      "maxDx": max_dx + ox,
      "minDz": min_dz + oz,
      "maxDz": max_dz + oz,
      "floorDy": args.floor_dy,
      "clearDy": args.clear_dy,
      "defaultMask": prefix_mask(0, args.floor_dy, args.clear_dy),
      "block": "minecraft:stone",
      "columns": terrain_columns(terrain_cells, vector, args.floor_dy, args.clear_dy),
    },
    "cornerCruise": {
      "routelet": f"{first}:{second}",
      "move": [dx2, dz2],
      "leadInMove": [dx1, dz1],
      "leadInBlocks": lead,
      "tailBlocks": tail,
      "cells": [[cell.dx, cell.dz] for cell in cells],
      "profiles": [profile.label() for profile in vector],
      "sourceSupport": support_quadrants(float(-dx1), float(-dz1), cells, vector, default, args.end_dy, args.horse_half_width),
      "targetSupport": pivot_support,
      "outgoingSupport": target_supports[1],
      "finalSupport": target_supports[-1],
      "targetSupports": target_supports,
      "endDy": args.end_dy,
    },
  }


def routelet_cells(first: str, second: str, args: argparse.Namespace) -> list[Cell]:
  dx1, dz1 = MOVES[first]
  dx2, dz2 = MOVES[second]
  incoming = candidate_cells_segment(float(-dx1), float(-dz1), 0.0, 0.0, args.horse_half_width, args.perturbation_radius, args.overshoot_horizon)
  outgoing = candidate_cells_segment(0.0, 0.0, float(dx2 * (args.tail_blocks + 1)), float(dz2 * (args.tail_blocks + 1)), args.horse_half_width, args.perturbation_radius, args.overshoot_horizon)
  return sorted(set(incoming) | set(outgoing))


def parse_routelet(raw: str) -> tuple[str, str]:
  first, sep, second = raw.partition(":")
  if sep != ":" or first not in MOVES or second not in MOVES:
    raise SystemExit(f"invalid routelet {raw!r}; expected MOVE:MOVE")
  return first, second


def routelet_scenario(args: argparse.Namespace) -> dict[str, Any]:
  cases: list[dict[str, Any]] = []
  mining: list[dict[str, Any]] = []
  domain = profile_domain(args.profiles)
  for raw in args.routelet or list(ROUTELETS):
    first, second = parse_routelet(raw)
    cells = routelet_cells(first, second, args)
    dx1, dz1 = MOVES[first]
    dx2, dz2 = MOVES[second]
    bounds = default_bounds(cells + [Cell(-args.lead_in_blocks * dx1, -args.lead_in_blocks * dz1), Cell(dx2 * (args.tail_blocks + 1), dz2 * (args.tail_blocks + 1))], args.halo)
    mining.append({
      "routelet": f"{first}:{second}",
      "first": [dx1, dz1],
      "second": [dx2, dz2],
      "leadInBlocks": args.lead_in_blocks,
      "tailBlocks": args.tail_blocks,
      "cells": [[cell.dx, cell.dz] for cell in cells],
      "profiles": [profile.label() for profile in domain],
    })
    filtering = args.target_support is not None or args.min_successor_support > 0 and not args.allow_known_bad
    sample_budget = args.max_cases if args.max_cases == 0 or not filtering else args.max_cases * 128
    accepted = 0
    for ordinal, vector in enumerate(product_or_sample(domain, len(cells), sample_budget, f"{args.seed}:routelet:{first}:{second}:{args.sample_seed}")):
      c = routelet_case(args, f"{first}_TO_{second}_{ordinal:06d}_{digest(vector)}", first, second, cells, vector, bounds)
      if support_allowed(args, c):
        cases.append(c)
        accepted += 1
        if args.max_cases > 0 and accepted >= args.max_cases:
          break
  return {
    "id": args.id,
    "worldKey": args.world_key,
    "seed": args.seed,
    "dimension": "minecraft:overworld",
    "timeoutSeconds": args.timeout_seconds,
    "horse": {"movementSpeed": args.movement_speed, "jumpStrength": args.jump_strength, "initialSpeed": 0.0},
    "input": {"forward": True},
    "ticks": args.ticks,
    "endRadius": args.end_radius,
    "maxEndYError": args.max_end_y_error,
    "requireNoDamage": True,
    "requireMounted": True,
    "stopAtEnd": True,
    "failOnOvershoot": True,
    "overshootSlack": args.overshoot_slack,
    "emitTrials": args.emit_trials,
    "perturbations": {
      "longitudinal": args.longitudinal,
      "lateral": args.lateral,
      "yaw": args.yaw,
      "initialSpeed": args.initial_speed,
      "initialLateralSpeed": args.initial_lateral_speed,
    },
    "cornerCruiseMining": {"schema": 2, "routelets": mining},
    "cases": cases,
  }


def support_allowed(args: argparse.Namespace, c: dict[str, Any]) -> bool:
  meta = c["cornerCruise"]
  if args.target_support is not None and meta["targetSupport"] not in args.target_support:
    return False
  if getattr(args, "allow_known_bad", False):
    return True
  min_successor = getattr(args, "min_successor_support", None)
  return min_successor is None or all(support >= min_successor for support in meta.get("targetSupports", [])[1:])


def write_json(path: Path, payload: Any) -> None:
  path.parent.mkdir(parents=True, exist_ok=True)
  tmp = path.with_suffix(path.suffix + ".tmp")
  tmp.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
  tmp.replace(path)


def read_json(path: Path) -> Any:
  return json.loads(path.read_text())


def iter_trace(path: Path) -> Iterable[dict[str, Any]]:
  with path.open(encoding="utf-8") as file:
    for line in file:
      line = line.strip()
      if not line:
        continue
      sample = json.loads(line)
      if sample.get("scope") == "mocap" and sample.get("type") == "tick" and sample.get("vehicle"):
        yield sample


def result_dir(raw: Path) -> Path:
  if raw.is_dir():
    return raw
  if raw.name == "trace.jsonl":
    return raw.parent
  return raw.parent if (raw.parent / "trace.jsonl").is_file() else raw


def trace_path(raw: Path) -> Path:
  d = result_dir(raw)
  return raw if raw.name == "trace.jsonl" else d / "trace.jsonl"


def summary_path(raw: Path) -> Path:
  return result_dir(raw) / "summary.json"


def plan_of(sample: dict[str, Any]) -> dict[str, Any]:
  return (((sample.get("transport") or {}).get("current") or {}).get("plan") or {})


def same_plan(a: dict[str, Any], b: dict[str, Any]) -> bool:
  return a.get("movement") == b.get("movement") and a.get("src") == b.get("src") and a.get("dest") == b.get("dest")


def vector3(raw: dict[str, Any] | None) -> dict[str, float]:
  raw = raw or {}
  return {"x": float(raw.get("x", 0.0)), "y": float(raw.get("y", 0.0)), "z": float(raw.get("z", 0.0))}


def pose3_from_trace(sample: dict[str, Any]) -> dict[str, float]:
  vehicle = sample.get("vehicle") or {}
  pos = vehicle.get("pos") or {}
  return {"x": float(pos.get("x", 0.0)), "y": float(pos.get("y", 0.0)), "z": float(pos.get("z", 0.0)), "yaw": float(vehicle.get("yaw", 0.0))}


def pose3_from_plan(raw: dict[str, Any]) -> dict[str, float]:
  return {"x": float(raw["x"]), "y": float(raw["y"]), "z": float(raw["z"])}


def future_edges_from_trace(samples: list[dict[str, Any]], root_i: int, max_edges: int) -> list[dict[str, Any]]:
  edges: list[dict[str, Any]] = []
  last_key: tuple[Any, Any, Any] | None = None
  for sample in samples[root_i:]:
    plan = plan_of(sample)
    movement = plan.get("movement")
    src = plan.get("src")
    dest = plan.get("dest")
    if not isinstance(movement, str) or not isinstance(src, dict) or not isinstance(dest, dict):
      continue
    key = (movement, tuple(sorted(src.items())), tuple(sorted(dest.items())))
    if key == last_key:
      continue
    last_key = key
    edges.append({"tick": int(sample.get("tick", 0)), "movement": movement, "src": pose3_from_plan(src), "dest": pose3_from_plan(dest)})
    if len(edges) >= max_edges:
      break
  return edges


def input_from_trace(sample: dict[str, Any]) -> dict[str, bool]:
  raw = sample.get("physicalInputs") or sample.get("inputs") or {}
  return {
    "forward": bool(raw.get("MOVE_FORWARD", False)),
    "backward": bool(raw.get("MOVE_BACK", False)),
    "left": bool(raw.get("MOVE_LEFT", False)),
    "right": bool(raw.get("MOVE_RIGHT", False)),
    "sprint": bool(raw.get("SPRINT", False)),
  }


def movement_slug(raw: str | None) -> str:
  if not raw:
    return "unknown"
  raw = raw.removeprefix("HorseRoute:")
  return re.sub(r"[^A-Za-z0-9_.+-]+", "_", raw).strip("_")[:64] or "unknown"


def fall_episodes(samples: list[dict[str, Any]], threshold: float) -> list[tuple[int, int, int]]:
  episodes: list[tuple[int, int, int]] = []
  active = False
  start = peak = 0
  for i, sample in enumerate(samples):
    fall_distance = float(((sample.get("vehicle") or {}).get("fallDistance") or 0.0))
    if fall_distance > 1.0e-9 and not active:
      start = max(0, i - 1)
      peak = i
      active = True
    if active:
      peak_fall = float(((samples[peak].get("vehicle") or {}).get("fallDistance") or 0.0))
      if fall_distance > peak_fall:
        peak = i
      if fall_distance == 0.0 and i > start + 1:
        if float(((samples[peak].get("vehicle") or {}).get("fallDistance") or 0.0)) >= threshold:
          episodes.append((start, peak, i))
        active = False
  if active:
    if float(((samples[peak].get("vehicle") or {}).get("fallDistance") or 0.0)) >= threshold:
      episodes.append((start, peak, len(samples) - 1))
  return episodes


def trace_fall_case(args: argparse.Namespace, run_dir: Path, samples: list[dict[str, Any]], episode: tuple[int, int, int], ordinal: int) -> dict[str, Any] | None:
  start_i, peak_i, end_i = episode
  fall_start = samples[start_i]
  peak = samples[peak_i]
  end_sample = samples[end_i]
  plan = plan_of(fall_start) or plan_of(peak)
  movement = plan.get("movement")
  dest = plan.get("dest")
  if args.require_route and (not isinstance(movement, str) or not movement.startswith(args.require_route)):
    return None
  if not isinstance(dest, dict):
    return None
  root_i = start_i
  if args.replay_root == "route-entry":
    while root_i > 0 and same_plan(plan_of(samples[root_i - 1]), plan):
      root_i -= 1
  start = samples[root_i]
  start_pose = pose3_from_trace(start)
  end_pose = pose3_from_plan(dest)
  peak_fd = float(((peak.get("vehicle") or {}).get("fallDistance") or 0.0))
  start_tick = int(start.get("tick", 0))
  fall_start_tick = int(fall_start.get("tick", start_tick))
  peak_tick = int(peak.get("tick", start_tick))
  end_tick = int(end_sample.get("tick", peak_tick))
  case_id = f"{run_dir.name}_fall{ordinal:02d}_t{start_tick}_p{peak_tick}_{movement_slug(movement)}"
  return {
    "id": case_id,
    "start": start_pose,
    "initialVelocity": vector3((start.get("vehicle") or {}).get("velocity")),
    "initialOnGround": bool((start.get("vehicle") or {}).get("onGround", False)),
    "initialFallDistance": float(((start.get("vehicle") or {}).get("fallDistance") or 0.0)),
    "targets": [end_pose],
    "end": end_pose,
    "input": input_from_trace(start) if args.trace_input else {"forward": args.forward, "backward": False, "left": False, "right": False, "sprint": False},
    "ticks": args.ticks,
    "minY": min(start_pose["y"], end_pose["y"]) - args.fall_tolerance,
    "stopAtEnd": False,
    "failOnOvershoot": False,
    "emitTrials": True,
    "thiswayFallReplay": {
      "sourceRun": str(run_dir),
      "sourceTick": start_tick,
      "fallStartTick": fall_start_tick,
      "peakTick": peak_tick,
      "endTick": end_tick,
      "replayRoot": args.replay_root,
      "peakFallDistance": peak_fd,
      "movement": movement,
      "planSrc": plan.get("src"),
      "planDest": dest,
      "futureEdges": future_edges_from_trace(samples, root_i, args.future_edges),
      "sourceFinalY": float(((end_sample.get("vehicle") or {}).get("pos") or {}).get("y", 0.0)),
    },
  }


def trace_falls_scenario(args: argparse.Namespace) -> dict[str, Any]:
  cases: list[dict[str, Any]] = []
  selected_world: tuple[str, str] | None = None
  for raw in args.result:
    run_dir = result_dir(raw)
    trace = trace_path(raw)
    if not trace.is_file():
      raise SystemExit(f"missing trace {trace}")
    summary = read_json(summary_path(run_dir)) if summary_path(run_dir).is_file() else {}
    world = (str(args.world_key or summary.get("worldKey") or "smoke_vd10"), str(args.seed or summary.get("seed") or "baritone-playtest-smoke"))
    selected_world = selected_world or world
    if world != selected_world:
      raise SystemExit(f"mixed replay worlds: {run_dir} has {world}, expected {selected_world}")
    samples = list(iter_trace(trace))
    episodes = fall_episodes(samples, args.min_fall_distance)
    episodes.sort(key=lambda ep: float(((samples[ep[1]].get("vehicle") or {}).get("fallDistance") or 0.0)), reverse=True)
    accepted = 0
    for ordinal, episode in enumerate(episodes):
      c = trace_fall_case(args, run_dir, samples, episode, ordinal)
      if c is None:
        continue
      cases.append(c)
      accepted += 1
      if args.max_cases_per_run > 0 and accepted >= args.max_cases_per_run:
        break
  if selected_world is None:
    selected_world = (str(args.world_key or "smoke_vd10"), str(args.seed or "baritone-playtest-smoke"))
  return {
    "id": args.id,
    "worldKey": selected_world[0],
    "seed": selected_world[1],
    "dimension": "minecraft:overworld",
    "timeoutSeconds": args.timeout_seconds,
    "horse": {"movementSpeed": args.movement_speed, "jumpStrength": args.jump_strength, "initialSpeed": 0.0},
    "input": {"forward": args.forward},
    "ticks": args.ticks,
    "endRadius": args.end_radius,
    "maxEndYError": args.max_end_y_error,
    "requireNoDamage": False,
    "requireMounted": True,
    "stopAtEnd": False,
    "failOnOvershoot": False,
    "emitTrials": True,
    "perturbations": {"longitudinal": [0.0], "lateral": [0.0], "yaw": [0.0], "initialSpeed": [0.0], "initialLateralSpeed": [0.0]},
    "thiswayFallReplayMining": {"schema": 1, "minFallDistance": args.min_fall_distance, "requireRoute": args.require_route, "sources": [str(result_dir(path)) for path in args.result]},
    "cases": cases,
  }


def command_make(args: argparse.Namespace) -> int:
  payload = scenario(args)
  write_json(args.out, payload)
  print(args.out)
  print(f"cases={len(payload['cases'])}")
  return 0


def command_run(args: argparse.Namespace) -> int:
  args.out_dir.mkdir(parents=True, exist_ok=True)
  scenario_path = args.out_dir / "corner-cruise-scenario.json"
  payload = scenario(args)
  write_json(scenario_path, payload)
  proc = subprocess.run([str(PLAYTEST), "physedge", str(scenario_path)], cwd=REPO, text=True, capture_output=True)
  if proc.stdout:
    print(proc.stdout, end="")
  if proc.stderr:
    print(proc.stderr, end="", file=sys.stderr)
  result_path = Path(proc.stdout.strip().splitlines()[-1]) if proc.stdout.strip() else None
  if result_path is not None and result_path.is_file():
    copied = args.out_dir / "corner-cruise-result.json"
    shutil.copy2(result_path, copied)
    summarize_result(copied, args.out_dir / "corner-cruise-summary.json")
  return proc.returncode


