#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import itertools
import json
import os
from pathlib import Path
import subprocess
import time
from typing import Any, Iterable

import optuna


REPO = Path(__file__).resolve().parents[1]
SCENARIO = REPO / "scenarios/playtest/horse_thisway_200_frontier.json"


def safe_name(raw: str) -> str:
  return "".join(c if c.isalnum() or c in "._-" else "_" for c in raw).strip("._-") or "study"


def run_text(args: list[str]) -> str:
  return subprocess.run(args, cwd=REPO, check=False, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.strip()


def git_head() -> str:
  out = run_text(["git", "rev-parse", "HEAD"])
  return out or "unknown"


def dirty_patch_digest() -> str:
  patch = subprocess.run(["git", "diff", "--binary"], cwd=REPO, check=False, stdout=subprocess.PIPE).stdout
  return "sha256:" + hashlib.sha256(patch).hexdigest()


def digest_bytes(data: bytes) -> str:
  return "sha256:" + hashlib.sha256(data).hexdigest()


def q(value: str) -> str:
  return json.dumps(value)


