#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

GRADLE_USER_HOME="${GRADLE_USER_HOME:-/home/main/.cache/gradle}"
PLAYTEST_ROOT="${PLAYTEST_ROOT:-$ROOT/run/playtest}"
HOST="${PLAYTEST_HOST:-127.0.0.1}"
PORT="${PLAYTEST_PORT:-25565}"
RCON_PORT="${PLAYTEST_RCON_PORT:-25575}"
RCON_PASSWORD="${PLAYTEST_RCON_PASSWORD:-}"
USERNAME="${PLAYTEST_USERNAME:-BaritoneTest}"
UUID="${PLAYTEST_UUID:-8b53c6c6-93e4-3df0-8b0c-415e38e60014}"
OBSERVER_USERNAME="${PLAYTEST_OBSERVER_USERNAME:-Shmooooo}"
OBSERVER_UUID="${PLAYTEST_OBSERVER_UUID:-f61d2165-7c93-3385-9866-c0918e509fcc}"
SCREEN="${PLAYTEST_SCREEN:-854x480x24}"
RESULT_TIMEOUT="${PLAYTEST_RESULT_TIMEOUT:-600}"
BASELINE_X="${PLAYTEST_BASELINE_X:-20}"
BASELINE_Y="${PLAYTEST_BASELINE_Y:-114}"
BASELINE_Z="${PLAYTEST_BASELINE_Z:-0}"

SERVER_PID="$PLAYTEST_ROOT/server.pid"
CLIENT_PID="$PLAYTEST_ROOT/client.pid"
STATE="$PLAYTEST_ROOT/state"

scenario_value() {
  local file="$1" key="$2" fallback="$3" value
  value="$(sed -nE "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"([^\"]*)\".*/\\1/p" "$file" | head -1 || true)"
  [[ -n "$value" ]] && printf '%s\n' "$value" || printf '%s\n' "$fallback"
}

safe_key() {
  printf '%s' "$1" | tr -c '[:alnum:]_.-' '_'
}

pid_alive() {
  [[ -f "$1" ]] && kill -0 "$(cat "$1")" 2>/dev/null
}

rcon_secret() {
  if [[ -n "$RCON_PASSWORD" ]]; then
    printf '%s\n' "$RCON_PASSWORD"
    return
  fi
  local file="$PLAYTEST_ROOT/rcon.password"
  mkdir -p "$PLAYTEST_ROOT"
  if [[ ! -f "$file" ]]; then
    if command -v openssl >/dev/null 2>&1; then
      (umask 077; openssl rand -hex 24 > "$file")
    else
      (umask 077; od -An -tx1 -N24 /dev/urandom | tr -d ' \n' > "$file"; printf '\n' >> "$file")
    fi
  fi
  cat "$file"
}

kill_pidfile() {
  local file="$1" pid
  [[ -f "$file" ]] || return 0
  pid="$(cat "$file")"
  kill -TERM "-$pid" 2>/dev/null || true
  pkill -TERM -P "$pid" 2>/dev/null || true
  kill "$pid" 2>/dev/null || true
  rm -f "$file"
}

world_from_arg() {
  local arg="${1:-default}"
  if [[ -f "$arg" ]]; then
    WORLD_KEY="$(scenario_value "$arg" worldKey default)"
    SEED="$(scenario_value "$arg" seed baritone-playtest)"
  else
    WORLD_KEY="$arg"
    SEED="${PLAYTEST_SEED:-baritone-playtest}"
  fi
  WORLD_KEY="$(safe_key "$WORLD_KEY")"
}

server_dir() {
  printf '%s/server/%s\n' "$PLAYTEST_ROOT" "$WORLD_KEY"
}

client_dir() {
  printf '%s/client\n' "$PLAYTEST_ROOT"
}

prepare_client_options() {
  local dir="$1" options tmp
  options="$dir/options.txt"
  [[ "${PLAYTEST_MUTE_CLIENT:-1}" != "0" ]] || return 0
  mkdir -p "$dir"
  tmp="$(mktemp "$dir/options.txt.XXXXXX")"
  if [[ -f "$options" ]]; then
    grep -vE '^(soundCategory_|musicToast:|musicFrequency:|showSubtitles:|directionalAudio:)' "$options" > "$tmp" || true
  fi
  {
    cat "$tmp"
    printf '%s\n' \
      'soundCategory_master:0.0' \
      'soundCategory_music:0.0' \
      'soundCategory_record:0.0' \
      'soundCategory_weather:0.0' \
      'soundCategory_block:0.0' \
      'soundCategory_hostile:0.0' \
      'soundCategory_neutral:0.0' \
      'soundCategory_player:0.0' \
      'soundCategory_ambient:0.0' \
      'soundCategory_voice:0.0' \
      'musicToast:"never"' \
      'musicFrequency:"OFF"' \
      'showSubtitles:false' \
      'directionalAudio:false'
  } > "$options"
  rm -f "$tmp"
}

prepare_server() {
  local dir="$1" rcon_password
  rcon_password="$(rcon_secret)"
  mkdir -p "$dir"
  cat > "$dir/eula.txt" <<EOF
eula=true
EOF
  cat > "$dir/server.properties" <<EOF
accepts-transfers=false
allow-flight=false
difficulty=peaceful
enable-command-block=false
enable-query=false
enable-rcon=true
enforce-secure-profile=false
gamemode=survival
generate-structures=true
level-name=world
level-seed=$SEED
max-players=4
motd=baritone-playtest
online-mode=false
prevent-proxy-connections=false
pvp=false
rcon.password=$rcon_password
rcon.port=$RCON_PORT
server-ip=
server-port=$PORT
simulation-distance=4
spawn-protection=0
view-distance=4
white-list=false
EOF
  cat > "$dir/ops.json" <<EOF
[
  {
    "uuid": "$OBSERVER_UUID",
    "name": "$OBSERVER_USERNAME",
    "level": 4,
    "bypassesPlayerLimit": false
  },
  {
    "uuid": "$UUID",
    "name": "$USERNAME",
    "level": 4,
    "bypassesPlayerLimit": true
  }
]
EOF
}

server_ready() {
  local log="$1"
  [[ -f "$log" ]] && grep -q "Done (" "$log"
}

start_server() {
  local dir="$1" log="$PLAYTEST_ROOT/logs/server.log"
  if pid_alive "$SERVER_PID"; then
    return 0
  fi
  prepare_server "$dir"
  mkdir -p "$PLAYTEST_ROOT/logs"
  : > "$log"
  setsid bash -c 'tail -f /dev/null | env GRADLE_USER_HOME="$1" ./gradlew :fabric:runPlaytestServer -PbaritonePlaytestServerDir="$2"' playtest-server "$GRADLE_USER_HOME" "$dir" > "$log" 2>&1 < /dev/null &
  echo $! > "$SERVER_PID"
  for _ in $(seq 1 180); do
    server_ready "$log" && return 0
    pid_alive "$SERVER_PID" || { tail -80 "$log" >&2; return 1; }
    sleep 1
  done
  tail -80 "$log" >&2
  return 1
}

start_client() {
  local cdir="$1" inbox="$PLAYTEST_ROOT/inbox" results="$PLAYTEST_ROOT/results" log="$PLAYTEST_ROOT/logs/client.log"
  if pid_alive "$CLIENT_PID"; then
    return 0
  fi
  mkdir -p "$cdir" "$inbox" "$results" "$PLAYTEST_ROOT/logs"
  prepare_client_options "$cdir"
  : > "$log"
  setsid xvfb-run -a -s "-screen 0 $SCREEN" env GRADLE_USER_HOME="$GRADLE_USER_HOME" ./gradlew :fabric:runPlaytestClient \
    -PbaritonePlaytestClientDir="$cdir" \
    -PbaritonePlaytestInbox="$inbox" \
    -PbaritonePlaytestResults="$results" \
    -PbaritonePlaytestServer="$HOST:$PORT" \
    -PbaritonePlaytestUsername="$USERNAME" \
    -PbaritonePlaytestUuid="$UUID" > "$log" 2>&1 < /dev/null &
  echo $! > "$CLIENT_PID"
}

prune_inbox() {
  local inbox="$PLAYTEST_ROOT/inbox"
  mkdir -p "$inbox"
  find "$inbox" -maxdepth 1 -type f -name '*.json' -delete
}

daemon() {
  world_from_arg "${1:-default}"
  mkdir -p "$PLAYTEST_ROOT"
  if [[ -f "$STATE" ]] && ! grep -qx "$WORLD_KEY" "$STATE"; then
    stop || true
  fi
  echo "$WORLD_KEY" > "$STATE"
  start_server "$(server_dir)"
  lock_world
  start_client "$(client_dir)"
  printf 'playtest daemon: world=%s seed=%s server=%s:%s\n' "$WORLD_KEY" "$SEED" "$HOST" "$PORT"
}

server_only() {
  world_from_arg "${1:-default}"
  mkdir -p "$PLAYTEST_ROOT"
  if [[ -f "$STATE" ]] && ! grep -qx "$WORLD_KEY" "$STATE"; then
    stop || true
  fi
  echo "$WORLD_KEY" > "$STATE"
  start_server "$(server_dir)"
  lock_world
  printf 'playtest server: world=%s seed=%s server=%s:%s\n' "$WORLD_KEY" "$SEED" "$HOST" "$PORT"
}

server_cmd() {
  local command="$*" rcon_password
  [[ -n "$command" ]] || { echo "server command required" >&2; exit 2; }
  pid_alive "$SERVER_PID" || { echo "playtest server is not running" >&2; exit 1; }
  rcon_password="$(rcon_secret)"
  python3 - "$HOST" "$RCON_PORT" "$rcon_password" "$command" <<'PY'
import socket
import struct
import sys

host, port, password, command = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4]

def packet(request_id, kind, payload):
    data = payload.encode("utf-8") + b"\0\0"
    return struct.pack("<iii", len(data) + 8, request_id, kind) + data

def recv_packet(sock):
    header = sock.recv(4)
    if len(header) != 4:
        raise SystemExit("rcon connection closed")
    (size,) = struct.unpack("<i", header)
    body = b""
    while len(body) < size:
        chunk = sock.recv(size - len(body))
        if not chunk:
            raise SystemExit("rcon connection closed")
        body += chunk
    request_id, kind = struct.unpack("<ii", body[:8])
    return request_id, kind, body[8:-2].decode("utf-8", "replace")

with socket.create_connection((host, port), timeout=5) as sock:
    sock.sendall(packet(1, 3, password))
    request_id, _, text = recv_packet(sock)
    if request_id == -1:
        raise SystemExit("rcon authentication failed")
    sock.sendall(packet(2, 2, command))
    _, _, text = recv_packet(sock)
    if text:
        print(text, end="" if text.endswith("\n") else "\n")
PY
}

server_cmd_retry() {
  local command="$*" output
  for _ in $(seq 1 30); do
    if output="$(server_cmd "$command" 2>/dev/null)"; then
      [[ -n "$output" ]] && printf '%s\n' "$output"
      return 0
    fi
    sleep 1
  done
  server_cmd "$command"
}

lock_world() {
  server_cmd_retry "gamerule advance_time false" >/dev/null
  server_cmd_retry "gamerule advance_weather false" >/dev/null
  server_cmd_retry "difficulty peaceful" >/dev/null
  server_cmd_retry "time set noon" >/dev/null
  server_cmd_retry "setworldspawn $BASELINE_X $BASELINE_Y $BASELINE_Z" >/dev/null
}

ensure_python_env() {
  local venv="$PLAYTEST_ROOT/py/.venv" python="$PLAYTEST_ROOT/py/.venv/bin/python"
  if [[ ! -x "$python" ]]; then
    command -v uv >/dev/null 2>&1 || { echo "uv is required for playtest Python helpers" >&2; exit 1; }
    uv venv "$venv" >/dev/null
  fi
  if ! "$python" -c 'import nbtlib' >/dev/null 2>&1; then
    command -v uv >/dev/null 2>&1 || { echo "uv is required to install nbtlib" >&2; exit 1; }
    uv pip install --python "$python" nbtlib >/dev/null
  fi
  printf '%s\n' "$python"
}

probe_block() {
  local x y z dimension python world_dir
  if (( $# < 3 )); then
    echo "usage: scripts/playtest probe [worldKey|scenario.json] <x> <y> <z> [dimension]" >&2
    exit 2
  fi
  if [[ "$1" =~ ^-?[0-9]+$ ]]; then
    WORLD_KEY="$(safe_key "$(cat "$STATE" 2>/dev/null || printf default)")"
  else
    world_from_arg "$1"
    shift
  fi
  if (( $# < 3 )); then
    echo "usage: scripts/playtest probe [worldKey|scenario.json] <x> <y> <z> [dimension]" >&2
    exit 2
  fi
  x="$1"
  y="$2"
  z="$3"
  dimension="${4:-minecraft:overworld}"
  if pid_alive "$SERVER_PID"; then
    server_cmd_retry "save-all flush" >/dev/null || true
  fi
  python="$(ensure_python_env)"
  world_dir="$PLAYTEST_ROOT/server/$WORLD_KEY/world"
  "$python" - "$world_dir" "$dimension" "$x" "$y" "$z" <<'PY'
from __future__ import annotations

import gzip
import io
import struct
import sys
import zlib
from pathlib import Path

import nbtlib

world = Path(sys.argv[1])
dimension = sys.argv[2]
x, y, z = map(int, sys.argv[3:6])


def region_candidates(world: Path, dimension: str) -> list[Path]:
    if dimension == "minecraft:overworld":
        return [world / "dimensions" / "minecraft" / "overworld" / "region", world / "region"]
    namespace, _, path = dimension.partition(":")
    if not namespace or not path:
        raise SystemExit(f"invalid dimension id: {dimension}")
    return [world / "dimensions" / namespace / path / "region"]


def region_root() -> Path:
    for candidate in region_candidates(world, dimension):
        if candidate.is_dir():
            return candidate
    raise SystemExit(f"no region directory for {dimension} under {world}")


regions = region_root()


def chunk_nbt(cx: int, cz: int):
    region = regions / f"r.{cx // 32}.{cz // 32}.mca"
    if not region.exists():
        return None, region
    index = (cx & 31) + ((cz & 31) * 32)
    with region.open("rb") as file:
        file.seek(index * 4)
        location = file.read(4)
        if len(location) != 4:
            return None, region
        offset = int.from_bytes(location[:3], "big")
        sectors = location[3]
        if offset == 0 or sectors == 0:
            return None, region
        file.seek(offset * 4096)
        length = struct.unpack(">I", file.read(4))[0]
        compression = file.read(1)[0]
        data = file.read(length - 1)
    match compression:
        case 1:
            data = gzip.decompress(data)
        case 2:
            data = zlib.decompress(data)
        case 3:
            pass
        case other:
            raise SystemExit(f"unsupported chunk compression {other} in {region}")
    return nbtlib.File.parse(io.BytesIO(data)), region


cx = x // 16
cz = z // 16
chunk, region = chunk_nbt(cx, cz)


def unpack(data, bits: int, index: int) -> int:
    if bits == 0:
        return 0
    values_per_long = 64 // bits
    long_index = index // values_per_long
    bit_index = (index % values_per_long) * bits
    value = int(data[long_index])
    if value < 0:
        value += 1 << 64
    return (value >> bit_index) & ((1 << bits) - 1)


def format_state(entry) -> str:
    name = str(entry.get("Name", "minecraft:air"))
    props = entry.get("Properties")
    if not props:
        return name
    return f"{name}[" + ",".join(f"{key}={str(value)}" for key, value in sorted(props.items())) + "]"


def block_state(bx: int, by: int, bz: int) -> str:
    if chunk is None:
        return "minecraft:air (uncreated chunk)"
    sy = by // 16
    for section in chunk["sections"]:
        if int(section["Y"]) != sy:
            continue
        states = section["block_states"]
        palette = states["palette"]
        if len(palette) == 1:
            palette_index = 0
        else:
            bits = max(4, (len(palette) - 1).bit_length())
            local_index = ((by & 15) << 8) | ((bz & 15) << 4) | (bx & 15)
            palette_index = unpack(states["data"], bits, local_index)
        if palette_index >= len(palette):
            return f"<corrupt palette index {palette_index}/{len(palette)}>"
        return format_state(palette[palette_index])
    return "minecraft:air (missing section)"


print(f"world={world}")
print(f"dimension={dimension}")
print(f"region={region}")
print(f"chunk={cx} {cz}")
for yy in range(y + 2, y - 3, -1):
    marker = ">" if yy == y else " "
    print(f"{marker} {x} {yy} {z}: {block_state(x, yy, z)}")
PY
}

default_player() {
  local provided="${1:-}" output names name count=0 selected=""
  if [[ -n "$provided" ]]; then
    printf '%s\n' "$provided"
    return
  fi
  output="$(server_cmd list)"
  names="${output#*: }"
  IFS=',' read -r -a players <<< "$names"
  for name in "${players[@]}"; do
    name="${name#"${name%%[![:space:]]*}"}"
    name="${name%"${name##*[![:space:]]}"}"
    [[ -n "$name" ]] || continue
    selected="$name"
    count=$((count + 1))
  done
  if (( count == 1 )); then
    printf '%s\n' "$selected"
    return
  fi
  echo "player name required; online players: $names" >&2
  exit 2
}

stage_scenario() {
  local scenario="$1" player
  [[ -f "$scenario" ]] || { echo "No scenario: $scenario" >&2; exit 2; }
  server_only "$scenario" >/dev/null
  player="$(default_player "${2:-}")"
  while IFS= read -r command; do
    [[ -n "$command" ]] && server_cmd "$command"
  done < <(python3 - "$scenario" "$player" <<'PY'
import json
import re
import sys

scenario_path, player = sys.argv[1], sys.argv[2]
with open(scenario_path, encoding="utf-8") as f:
    scenario = json.load(f)

if not re.fullmatch(r"[A-Za-z0-9_]{1,16}", player):
    raise SystemExit(f"unsupported player name for command target: {player!r}")

def number(obj, name, default):
    value = obj.get(name, default)
    return default if value is None else value

def tellraw(parts):
    print("tellraw " + player + " " + json.dumps(parts, separators=(",", ":")))

sid = scenario.get("id") or scenario_path
dimension = scenario.get("dimension", "minecraft:overworld")
start = scenario.get("start") or {}
goal = scenario.get("goal") or {}
loadout = scenario.get("loadout") or []
settings = scenario.get("settings") or {}
selected_slot = scenario.get("selectedSlot")
if selected_slot is None:
    selected_slot = next((item.get("slot", -1) for item in loadout if item.get("slot", -1) >= 0), 0)

commands = [
    "gamerule advance_time false",
    "gamerule advance_weather false",
    "time set noon",
    "weather clear",
    "difficulty peaceful",
    "kill @e[type=!minecraft:player]",
    f"gamemode survival {player}",
    f"effect clear {player}",
    f"effect give {player} minecraft:instant_health 1 10 true",
    f"effect give {player} minecraft:saturation 1 10 true",
    f"clear {player}",
]
commands.extend(str(command) for command in scenario.get("setupCommands") or [])
commands.append(
    "execute in %s run tp %s %.3f %.3f %.3f %.2f %.2f"
    % (
        dimension,
        player,
        float(number(start, "x", 0.0)),
        float(number(start, "y", 80.0)),
        float(number(start, "z", 0.0)),
        float(number(start, "yaw", 0.0)),
        float(number(start, "pitch", 0.0)),
    )
)
for item in loadout:
    item_id = item.get("item", "minecraft:air")
    count = int(item.get("count", 1))
    slot = int(item.get("slot", -1))
    if slot >= 0:
        commands.append(f"item replace entity {player} hotbar.{slot} with {item_id} {count}")
    else:
        commands.append(f"give {player} {item_id} {count}")

for command in commands:
    print(command)

tellraw([{"text": f"Staged playtest scenario {sid}.", "color": "green"}])

for name, value in settings.items():
    baritone = f"#set {name} {str(value).lower() if isinstance(value, bool) else value}"
    tellraw([
        {"text": "Baritone setting: ", "color": "gray"},
        {
            "text": baritone,
            "color": "aqua",
            "underlined": True,
            "clickEvent": {"action": "suggest_command", "value": baritone},
            "hoverEvent": {"action": "show_text", "contents": "Click to paste, then press Enter."},
        },
    ])

if goal.get("type", "block").lower() == "block":
    baritone = "#goto %d %d %d" % (int(goal.get("x", 0)), int(goal.get("y", 80)), int(goal.get("z", 0)))
    tellraw([
        {"text": "Baritone goal: ", "color": "gold"},
        {
            "text": baritone,
            "color": "aqua",
            "underlined": True,
            "clickEvent": {"action": "suggest_command", "value": baritone},
            "hoverEvent": {"action": "show_text", "contents": "Click to paste, then press Enter."},
        },
    ])
else:
    tellraw([{"text": f"Unsupported manual Baritone goal type: {goal.get('type')}", "color": "red"}])

if selected_slot is not None:
    tellraw([{"text": f"Select hotbar slot {int(selected_slot) + 1} before running if the scenario depends on held item.", "color": "yellow"}])
PY
  )
}

run_scenario() {
  local scenario="$1" base run_id target summary deadline
  [[ -f "$scenario" ]] || { echo "No scenario: $scenario" >&2; exit 2; }
  prune_inbox
  daemon "$scenario" >/dev/null
  base="$(safe_key "$(basename "$scenario" .json)")"
  run_id="$base-$(date -u +%Y%m%dT%H%M%SZ)-$$"
  target="$PLAYTEST_ROOT/inbox/$run_id.json"
  summary="$PLAYTEST_ROOT/results/$run_id/summary.json"
  cp "$scenario" "$target"
  deadline=$((SECONDS + RESULT_TIMEOUT))
  while (( SECONDS < deadline )); do
    if [[ -f "$summary" ]]; then
      printf '%s\n' "$summary"
      grep -q '"success": true' "$summary"
      return
    fi
    pid_alive "$CLIENT_PID" || { tail -120 "$PLAYTEST_ROOT/logs/client.log" >&2; return 1; }
    sleep 1
  done
  echo "Timed out waiting for $summary" >&2
  tail -120 "$PLAYTEST_ROOT/logs/client.log" >&2
  return 1
}

run_suite() {
  local manifest="${1:-scenarios/playtest/locked.txt}" scenario status=0
  [[ -f "$manifest" ]] || { echo "No suite manifest: $manifest" >&2; exit 2; }
  while IFS= read -r scenario || [[ -n "$scenario" ]]; do
    scenario="${scenario%%#*}"
    scenario="${scenario#"${scenario%%[![:space:]]*}"}"
    scenario="${scenario%"${scenario##*[![:space:]]}"}"
    [[ -n "$scenario" ]] || continue
    printf 'playtest suite: %s\n' "$scenario"
    if ! run_scenario "$scenario"; then
      status=1
    fi
  done < "$manifest"
  return "$status"
}

stop() {
  kill_pidfile "$CLIENT_PID"
  kill_pidfile "$SERVER_PID"
}

case "${1:-}" in
  server)
    shift
    server_only "${1:-default}"
    ;;
  stage)
    shift
    stage_scenario "${1:?scenario json required}" "${2:-}"
    ;;
  daemon)
    shift
    daemon "${1:-default}"
    ;;
  cmd)
    shift
    server_cmd "$@"
    ;;
  probe)
    shift
    probe_block "$@"
    ;;
  run)
    shift
    run_scenario "${1:?scenario json required}"
    ;;
  once)
    shift
    trap stop EXIT
    run_scenario "${1:?scenario json required}"
    ;;
  suite)
    shift
    run_suite "${1:-scenarios/playtest/locked.txt}"
    ;;
  stop)
    stop
    ;;
  *)
    echo "usage: scripts/playtest server [worldKey|scenario.json] | stage <scenario.json> [player] | daemon [worldKey|scenario.json] | cmd <server command> | probe [worldKey|scenario.json] <x> <y> <z> [dimension] | run <scenario.json> | once <scenario.json> | suite [manifest] | stop" >&2
    exit 2
    ;;
esac
